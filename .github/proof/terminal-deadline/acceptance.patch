+  it.runIf(process.platform !== "win32")(
+    "opens a real PTY when wall time jumps during catalog lookup",
+    async () => {
+      const marker = `terminal-deadline-${process.pid}`;
+      const chunks: string[] = [];
+      const manager = new TerminalSessionManager({
+        emit: (_connId, event, payload) => {
+          const data = (payload as { data?: unknown }).data;
+          if (event === TERMINAL_EVENT_DATA && typeof data === "string") {
+            chunks.push(data);
+          }
+        },
+      });
+      let wallNow = 1_000_000;
+      const dateNow = vi.spyOn(Date, "now").mockImplementation(() => wallNow);
+      try {
+        installCatalog({
+          id: "clock-step",
+          label: "Clock step",
+          list: async () => [],
+          read: async (request) => ({ ...request, items: [] }),
+          openTerminal: async () => {
+            wallNow += TERMINAL_OPEN_DEADLINE_MS + 1;
+            return {
+              kind: "local",
+              argv: [
+                process.execPath,
+                "-e",
+                `process.stdout.write(${JSON.stringify(marker)}); setInterval(() => {}, 1_000)`,
+              ],
+            };
+          },
+        });
+        const { opts, respond } = makeOpts(
+          {
+            cols: 80,
+            rows: 24,
+            catalog: { catalogId: "clock-step", hostId: "gateway:local", threadId: "thread" },
+          },
+          { enabled: true },
+        );
+        opts.context.terminalSessions = manager;
+
+        await expectDefined(terminalHandlers["terminal.open"], "terminal.open")(opts);
+
+        const opened = respond.mock.calls.find(([ok]) => ok === true)?.[1] as
+          | { sessionId?: string }
+          | undefined;
+        expect(opened?.sessionId, JSON.stringify(respond.mock.calls)).toEqual(expect.any(String));
+        await waitForFast(() => expect(chunks.join("")).toContain(marker), { timeout: 5_000 });
+      } finally {
+        dateNow.mockRestore();
+        manager.disposeAll();
+      }
+    },
+  );
+
+  it("keeps the open budget stable when wall time moves backward", async () => {
